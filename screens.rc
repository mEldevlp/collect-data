#include <winver.h>
#include <winuser.h>

#pragma code_page(65001)

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "screens.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Скриншоты для collect_audit.cmd"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "screens"
            VALUE "OriginalFilename", "screens.exe"
            VALUE "ProductName", "collect_data screens"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
